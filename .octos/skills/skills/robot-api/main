#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/target/release/robot_api"

if [[ ! -x "$BIN" ]]; then
  if ! command -v cargo >/dev/null 2>&1; then
    printf '{"output":"Skill binary is missing and cargo is not installed. Run: cargo build --release in robot_api","success":false}\n'
    exit 0
  fi
  if ! (cd "$SCRIPT_DIR" && cargo build --release >/dev/null 2>&1); then
    printf '{"output":"Failed to build skill binary with cargo build --release.","success":false}\n'
    exit 0
  fi
fi

exec "$BIN" "$@"
